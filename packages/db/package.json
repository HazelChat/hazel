{
	"name": "@hazel/db",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"main": "src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./schema": "./src/tables/index.ts",
		"./tables": "./src/tables/index.ts",
		"./migrate": "./src/migrate.ts"
	},
	"scripts": {
		"db:generate": "bun --bun effect-orm generate",
		"db:check": "bun --bun effect-orm check",
		"db:migrate": "bun scripts/migrate.ts",
		"db:status": "bun --bun effect-orm status",
		"db:verify": "bun --bun effect-orm verify",
		"setup": "bun scripts/migrate.ts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@effect/sql-pg": "catalog:effect",
		"@hazel/domain": "workspace:*",
		"@hazel/schema": "workspace:*",
		"@maple-dev/effect-orm": "0.5.0",
		"effect": "catalog:effect"
	},
	"devDependencies": {
		"@testcontainers/postgresql": "^10.18.0",
		"@types/bun": "1.3.9",
		"typescript": "^5.9.3"
	}
}
