# Server
PORT=8184

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/app
IS_DEV=true

# Electric SQL
ELECTRIC_URL=http://localhost:3333
# Self-hosted Electric's ELECTRIC_SECRET (unset for docker-compose Electric, which runs insecure)
# ELECTRIC_SECRET=
# Legacy Electric Cloud credentials (Bun entry on Railway only; removed at the Cloudflare cutover)
# ELECTRIC_SOURCE_ID=
# ELECTRIC_SOURCE_SECRET=

# Hazel access tokens (Bearer JWTs from the API's POST /auth/token). The issuer is the API
# origin; the public keys come from its JWKS, which must be HTTPS. For a local plain-HTTP API,
# set AUTH_ACCESS_TOKEN_JWKS to the key set `bun run --cwd packages/auth generate-keys` prints.
API_BASE_URL=http://localhost:3003
# AUTH_ACCESS_TOKEN_JWKS={"keys":[...]}

# CORS
ALLOWED_ORIGIN=http://localhost:3000

# OpenTelemetry (optional)
OTLP_ENDPOINT=http://localhost:4318/v1/traces
